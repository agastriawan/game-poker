# Konfigurasi Supabase (Untuk Multiplayer Online Lintas Perangkat & Deploy Vercel)
# Salin file ini menjadi .env.local dan isi dengan URL & Anon Key dari Dashboard Supabase Anda
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Konfigurasi Metered TURN Server (Untuk Voice Chat Lintas Jaringan / Beda Wi-Fi & Kuota Seluler)
METERED_DOMAIN=pokerbarudak.metered.live
METERED_SECRET_KEY=your_metered_secret_key

